PORT=8090
CORS_ORIGIN=http://localhost:5173

# Groq remains the default provider when configured.
groq_API_KEY=
groq_API_BASE=https://api.groq.com/openai/v1
groq_MODEL=llama-3.3-70b-versatile

# Configure both the key and a supported model ID to expose each provider.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional explicit default; otherwise Groq is preferred when configured.
LLM_DEFAULT_PROVIDER=
LLM_DEFAULT_MODEL=
